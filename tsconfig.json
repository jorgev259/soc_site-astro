{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": "src",
    "strictNullChecks": true,
    "allowJs": true,
    "paths": {
      "@/prisma/*": ["../prisma/generated/*"]
    },
    "exactOptionalPropertyTypes": false
  }
}
