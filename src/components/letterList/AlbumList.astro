---
import { AlbumStatus } from '@/prisma/enums'
import prismaClient from 'utils/prisma-client'

interface Props {
  letter: string
}

const { letter } = Astro.props
const albums = await prismaClient.albums.findMany({
  where: { status: AlbumStatus.SHOW, title: { startsWith: letter } },
  select: { id: true, title: true }
})
---

{
  albums.map((a) => (
    <a class='text-left hover:bg-btn-gray/30 rounded-md p-2' href={`/album/${a.id}`}>
      {a.title}
    </a>
  ))
}
