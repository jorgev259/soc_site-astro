---
import { Image } from 'astro:assets'
import prismaClient from 'utils/prisma-client'
import { getImgUrl } from 'utils/cdn'

interface Props {
  letter: string
}

const { letter } = Astro.props
const albums = await prismaClient.series.findMany({
  where: { name: { startsWith: letter } },
  select: { slug: true }
})
---

{
  albums.map((a) => (
    <a class='group text-left rounded-md p-2' href={`/series/${a.slug}`}>
      <Image
        src={getImgUrl(`series/${a.slug}.png`)}
        alt={a.slug}
        height={500}
        width={500}
        quality='low'
        class='rounded-md scale-95 group-hover:scale-98 transition-transform'
      />
    </a>
  ))
}
