---
import { Image, Picture } from 'astro:assets'
import * as m from '../paraglide/messages.js'

import { hasPermission } from 'auth/auth-server'
import { getImgUrl } from 'utils/cdn'

import logo from 'img/logos/winter.png'
import logoEs from 'img/logos/default_es.png'

import Dropdown from './header/Dropdown.astro'
import DropdownItem from './header/DropdownItem.astro'
import Toggler from './header/Toggler.astro'
import NavButton from './header/NavButton.astro'
import LoginNav from './header/LoginNav.astro'
import SearchBar from './search/SearchBar.astro'
import ProfileCard from './header/ProfileCard.astro'

/* const bannerPositionConfig = await prismaClient.config.findUnique({
  where: { name: 'banner-position' },
  select: { value: true }
})
const bannerPosition = bannerPositionConfig?.value || 'top' */

const { session, user } = Astro.locals
const [hasUpdate, hasPublish] = await Promise.all([
  hasPermission(user?.id, { cms: ['update'] }),
  hasPermission(user?.id, { cms: ['publish'] })
])
---

<header class='relative'>
  <div class='relative h-37.5 bg-top bg-no-repeat bg-cover justify-center'>
    <div class='absolute size-full'>
      <Picture
        class='size-full object-cover object-top'
        src={getImgUrl(`live/banner.png`)}
        alt=''
        width={2560}
        height={150}
      />
    </div>
    <div class='relative size-full flex'>
      <a href='/'>
        <Image
          src={Astro.currentLocale === 'es' ? logoEs : logo}
          class='h-full md:py-0.5 w-auto mx-2.5 md:mx-10'
          alt='logo'
          height={150}
          width={265}
        />
      </a>
      {session ? <ProfileCard class='hidden md:block' /> : <LoginNav />}
    </div>
  </div>
  <div class='relative w-full md:h-13.75 bg-dark z-40'>
    <Toggler>
      <ProfileCard class='block md:hidden w-full' />
      <a href='/'><NavButton>{m.home()}</NavButton></a>
      <a href='/last-added'><NavButton>{m.lastaddednav()}</NavButton></a>
      <a href='/album/list'><NavButton>{m.albumlist()}</NavButton></a>
      <Dropdown>
        {m.games()}
        <Fragment slot='items'>
          <DropdownItem href='/game/latest'>{m.latestReleases()}</DropdownItem>
          <DropdownItem href='/game/list'>{m.gamelist()}</DropdownItem>
          <DropdownItem href='/series/list'>{m.series()}</DropdownItem>
          <DropdownItem href='/publisher/list'>{m.publishers()}</DropdownItem>
          <DropdownItem href='/platform/list'>{m.platforms()}</DropdownItem>
        </Fragment>
      </Dropdown>
      <Dropdown>
        {m.animation()}
        <Fragment slot='items'>
          <DropdownItem href='/anim/latest'>{m.latestReleases()}</DropdownItem>
          <DropdownItem href='/anim/list'>{m.animationlist()}</DropdownItem>
          <DropdownItem href='/studio/list'>{m.studios()}</DropdownItem>
        </Fragment>
      </Dropdown>
      <a href='/requests'>
        <NavButton>{m.requests()}</NavButton>
      </a>

      {
        session ? (
          <>
            {/* <NavButton>{m.submitalbum()}</NavButton> */}
            {hasUpdate || hasPublish ? (
              <Dropdown>
                {m.adminGrounds()}

                <Fragment slot='items'>
                  {hasPublish ? <DropdownItem href='/admin/album'>Create album</DropdownItem> : null}
                  {hasUpdate ? (
                    <>
                      <DropdownItem href='/admin'>{m.dashboard()}</DropdownItem>
                      <DropdownItem href='/admin/user'>{m.manageUsers()}</DropdownItem>
                      <DropdownItem href='/admin/request'>{m.manageRequests()}</DropdownItem>
                      <DropdownItem href='/admin/submission'>{m.manageSubmissions()}</DropdownItem>
                    </>
                  ) : null}
                </Fragment>
              </Dropdown>
            ) : null}
          </>
        ) : null
      }

      <SearchBar />
    </Toggler>
  </div>
</header>
