---
import * as m from 'paraglide/messages'
import { Image } from 'astro:assets'
import { AlbumStatus } from '@/prisma/enums'

import prismaClient from 'utils/prisma-client'
import SearchNav from './SearchNav.astro'
import AlbumBox from 'components/AlbumBox.astro'
import { getImgUrl } from 'utils/cdn'
import { getWords, sortByRelevance } from 'utils/search'

interface Props {
  query: string
  page: number
}

const take = 24
const sectionTake = 12
const { query } = Astro.props
const page = Math.max(1, Astro.props.page || 1)

// Every word has to match, otherwise "Pokemon Gold" also brings up every album with "Gold" in it
const words = getWords(query)
const [albumRows, animRows, gameRows, seriesRows] =
  words.length > 0
    ? await Promise.all([
        prismaClient.albums.findMany({
          where: {
            status: AlbumStatus.SHOW,
            AND: words.map((word) => ({ OR: [{ title: { contains: word } }, { subTitle: { contains: word } }] }))
          },
          select: { id: true, title: true, releaseDate: true },
          orderBy: { releaseDate: 'desc' } // albums that rank the same stay newest first
        }),
        prismaClient.animation.findMany({
          where: { AND: words.map((word) => ({ title: { contains: word } })) },
          select: { id: true, title: true }
        }),
        prismaClient.game.findMany({
          where: { AND: words.map((word) => ({ name: { contains: word } })) },
          select: { slug: true, name: true }
        }),
        prismaClient.series.findMany({
          where: { AND: words.map((word) => ({ name: { contains: word } })) },
          select: { slug: true, name: true }
        })
      ])
    : [[], [], [], []]

const albums = sortByRelevance(albumRows, words, (album) => album.title)
const anims = sortByRelevance(animRows, words, (anim) => anim.title)
const games = sortByRelevance(gameRows, words, (game) => game.name)
const series = sortByRelevance(seriesRows, words, (s) => s.name)

const start = (page - 1) * take
const end = Math.min(start + take, albums.length)
---

<div class='grid md:grid-cols-2 grid-cols-1'>
  {
    anims.length > 0 ? (
      <div class='col-span-1'>
        <div class='mb-2 text-lg text-slate-300 uppercase'>Animations ({anims.length})</div>
        <div class='flex flex-wrap gap-2 mb-4'>
          {anims.slice(0, sectionTake).map((anim) => (
            <div class='md:w-1/3 w-1/2'>
              <AlbumBox
                class='!bg-btn-dark !mt-0'
                title={anim.title}
                href={`/anim/${anim.id}`}
                image={`anim/${anim.id}.png`}
              />
            </div>
          ))}
        </div>
      </div>
    ) : null
  }
  {
    games.length > 0 ? (
      <div class='col-span-1 border-0 md:border-l-2 border-slate-600 pl-4'>
        <div class='mb-2 text-lg text-slate-300 uppercase'>Games ({games.length})</div>
        {games.slice(0, sectionTake).map((game) => (
          <div class='gap-2 mb-1'>
            <a class='text-left hover:bg-btn-gray/30 rounded-md p-1 px-2' href={`/game/${game.slug}`}>
              {game.name}
            </a>
          </div>
        ))}
      </div>
    ) : null
  }
</div>

{
  series.length > 0 ? (
    <>
      <div class='mb-2 text-lg text-slate-300 uppercase'>Game Series ({series.length})</div>
      <div class='flex'>
        {series.slice(0, sectionTake).map((s) => (
          <a
            class='md:w-1/4 w-1/2 text-center bg-gray rounded-xl overflow-hidden shadow-md hover:shadow-lg hover:scale-105 transition group'
            href={`/series/${s.slug}`}
          >
            <Image
              src={getImgUrl(`series/${s.slug}.png`)}
              alt={`${s.name} logo`}
              class='m-auto '
              quality='low'
              width={120}
              height={60}
            />
            {s.name}
          </a>
        ))}
      </div>
    </>
  ) : null
}

<div class='text-lg text-slate-300 uppercase'>
  {m.albums()} ({albums.length}) {
    albums.length > take ? (
      <span> / {page === 1 ? m.firstResults({ take }) : m.moreResults({ start: start + 1, end })}</span>
    ) : null
  }
</div>

<div class='flex gap-x-2'>
  <SearchNav query={query} count={albums.length} take={take} page={page} />
</div>

<div class='grid grid-cols-1 md:grid-cols-3 mt-1.5 gap-4'>
  {
    albums.slice(start, end).map((album) => (
      <a
        class='flex bg-gray h-40 cursor-pointer rounded overflow-hidden shadow-md hover:shadow-lg hover:scale-102 transition group'
        href={`/album/${album.id}`}
      >
        <div class='h-full w-40 shrink-0'>
          <Image
            class='object-cover'
            src={getImgUrl(`album/${album.id}.png`)}
            alt={`${album.title} cover`}
            quality='low'
            height={160}
            width={160}
          />
        </div>
        <div class='flex flex-col p-2.5 justify-center text-left'>
          <div class=''>{album.title}</div>
          <div class='text-sm text-slate-300 mt-0.5'>
            {album.releaseDate ? new Date(album.releaseDate).toISOString().split('T')[0] : ''}
          </div>
        </div>
      </a>
    ))
  }
</div>

<div class='flex gap-x-2'>
  <SearchNav query={query} count={albums.length} take={take} page={page} />
</div>
